# =============================================================================
# Singha Auctions V2 — environment template
# Copy to `.env` for local development. NEVER commit a real `.env` (see docs/15).
# Unknown BUSINESS values are placeholders and marked BUSINESS_APPROVAL_REQUIRED
# (docs/20). Providers are behind adapters and default to "not configured".
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Service ports ---------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
WORKER_METRICS_PORT=4100

# --- Public URLs -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL (authoritative store) --------------------------------------
# Local dev via docker-compose (infrastructure/docker-compose.yml) OR native
# Postgres. The ephemeral verification DB uses a temporary port (see scripts).
DATABASE_URL=postgresql://singha:singha@localhost:5432/singha_v2?schema=public

# --- Redis (cache, locks, queues) ------------------------------------------
# Optional in Phase 0: the worker degrades to a no-op when REDIS_URL is empty.
REDIS_URL=redis://localhost:6379

# --- Auth / security -------------------------------------------------------
# Generate strong values for real environments; these are safe local defaults.
JWT_SECRET=dev-only-insecure-change-me
SESSION_SECRET=dev-only-insecure-change-me

# =============================================================================
# Business configuration (Class C — product-owner approval, docs/20)
# Values below are SAFE PLACEHOLDERS so implementation is never blocked.
# =============================================================================
# BUSINESS_APPROVAL_REQUIRED — buyer premium (percent of hammer)
BUSINESS_BUYER_PREMIUM_PCT=0
# BUSINESS_APPROVAL_REQUIRED — seller commission (percent of hammer)
BUSINESS_SELLER_COMMISSION_PCT=0
# BUSINESS_APPROVAL_REQUIRED — VAT / tax percent
BUSINESS_TAX_PCT=0
# BUSINESS_APPROVAL_REQUIRED — payment deadline (hours after sale)
BUSINESS_PAYMENT_DEADLINE_HOURS=72
# BUSINESS_APPROVAL_REQUIRED — collection deadline (days after payment)
BUSINESS_COLLECTION_DEADLINE_DAYS=14

# --- Default currency / locale ---------------------------------------------
DEFAULT_CURRENCY=LKR
DEFAULT_LOCALE=en

# =============================================================================
# Feature flags (docs/18). Deploy disabled -> internal -> cohort -> general.
# =============================================================================
FEATURE_TIMED_AUCTIONS=true
FEATURE_EOI=true
FEATURE_BUY_NOW=false
FEATURE_MAKE_OFFER=false
FEATURE_SEALED_TENDER=false
FEATURE_LIVE_AUCTIONS=false
FEATURE_CUBE_CATALOGUE=true
FEATURE_AI_LISTING=false
FEATURE_AI_MEDIA_ENHANCE=false
FEATURE_SOCIAL_AUTO_PUBLISH=false
FEATURE_WHATSAPP_BID_INTENT=false

# =============================================================================
# Provider credentials (Class D — developer/infra only, docs/02 & docs/21).
# Leave blank in local dev; adapters report "not configured" and use mocks.
# =============================================================================
# Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# AI providers
AI_TEXT_API_KEY=
AI_VISION_API_KEY=
# Messaging (Meta / WhatsApp / SMS / email)
META_APP_SECRET=
WHATSAPP_TOKEN=
SMS_API_KEY=
EMAIL_API_KEY=
# Live streaming (evaluate Amazon IVS behind adapter, docs/21)
LIVE_PROVIDER_KEY=
YOUTUBE_API_KEY=
# Payments (abstraction first — merchant selection is a commercial decision)
PAYMENT_PROVIDER_KEY=
